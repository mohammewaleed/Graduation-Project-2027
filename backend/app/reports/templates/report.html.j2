<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Security Report — {{ project.name }} ({{ scan.id[:8] }})</title>
  <style>
    :root {
      --bg: #f8fafc;
      --surface: #ffffff;
      --surface-alt: #f1f5f9;
      --border: #e2e8f0;
      --border-strong: #cbd5e1;
      --text: #0f172a;
      --text-muted: #475569;
      --text-subtle: #64748b;
      --accent: #0f172a;
      --critical: #dc2626;
      --critical-bg: #fef2f2;
      --critical-border: #fecaca;
      --high: #ea580c;
      --high-bg: #fff7ed;
      --high-border: #fed7aa;
      --medium: #d97706;
      --medium-bg: #fffbeb;
      --medium-border: #fde68a;
      --low: #2563eb;
      --low-bg: #eff6ff;
      --low-border: #bfdbfe;
      --info: #475569;
      --info-bg: #f1f5f9;
      --info-border: #cbd5e1;
      --clean: #16a34a;
      --clean-bg: #f0fdf4;
      --clean-border: #bbf7d0;
      --code-bg: #0f172a;
      --code-text: #e2e8f0;
      --radius: 10px;
      --shadow: 0 1px 3px rgba(15, 23, 42, 0.08), 0 1px 2px rgba(15, 23, 42, 0.04);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 24px 16px 48px;
      font-family: "Plus Jakarta Sans", "Segoe UI Variable", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.55;
      font-size: 14px;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 1120px;
      margin: 0 auto;
    }

    /* Header Banner */
    .report-banner {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: #f8fafc;
      border-radius: 14px;
      padding: 28px 32px;
      box-shadow: var(--shadow);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 24px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }

    .banner-main {
      flex: 1 1 520px;
      min-width: 260px;
    }

    .banner-eyebrow {
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #94a3b8;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .banner-title {
      margin: 0 0 8px;
      font-size: 26px;
      line-height: 1.2;
      font-weight: 800;
      color: #ffffff;
      word-break: break-word;
    }

    .banner-url {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 13px;
      color: #cbd5e1;
      background: rgba(255, 255, 255, 0.08);
      display: inline-block;
      padding: 4px 10px;
      border-radius: 6px;
      margin-bottom: 14px;
      word-break: break-all;
    }

    .meta-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 20px;
      font-size: 12px;
      color: #cbd5e1;
    }

    .meta-item strong {
      color: #f8fafc;
      font-weight: 600;
    }

    /* Risk Score Badge */
    .risk-badge {
      flex: 0 0 auto;
      min-width: 170px;
      text-align: center;
      background: rgba(255, 255, 255, 0.06);
      border: 2px solid rgba(255, 255, 255, 0.16);
      border-radius: 12px;
      padding: 16px 20px;
    }

    .risk-badge.risk-critical { border-color: #f87171; background: rgba(220, 38, 38, 0.18); }
    .risk-badge.risk-high { border-color: #fb923c; background: rgba(234, 88, 12, 0.18); }
    .risk-badge.risk-medium { border-color: #fbbf24; background: rgba(217, 119, 6, 0.18); }
    .risk-badge.risk-low { border-color: #60a5fa; background: rgba(37, 99, 235, 0.18); }
    .risk-badge.risk-clean { border-color: #4ade80; background: rgba(22, 163, 74, 0.18); }

    .risk-score-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #cbd5e1;
      font-weight: 700;
    }

    .risk-score-value {
      font-size: 40px;
      line-height: 1.1;
      font-weight: 800;
      color: #ffffff;
      margin: 4px 0;
    }

    .risk-score-value span {
      font-size: 16px;
      font-weight: 600;
      color: #cbd5e1;
    }

    .risk-score-level {
      font-size: 12px;
      font-weight: 700;
      color: #f8fafc;
    }

    /* KPI Strip (2 Balanced Rows: 4 Overview + 5 Severity) */
    .kpi-section {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 22px;
    }

    .kpi-row-overview {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .kpi-row-severity {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 12px;
    }

    @media (max-width: 780px) {
      .kpi-row-overview {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .kpi-row-severity {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 480px) {
      .kpi-row-severity {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    .kpi-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px 16px;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-width: 0;
    }

    .kpi-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-subtle);
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .kpi-value {
      font-size: 28px;
      font-weight: 800;
      line-height: 1.15;
      margin-top: 6px;
      color: var(--text);
      font-variant-numeric: tabular-nums;
      letter-spacing: -0.02em;
    }

    .kpi-card.kpi-sev {
      border-top-width: 3px;
      padding: 12px 16px 14px;
    }

    .kpi-card.kpi-critical { border-top-color: var(--critical); background: linear-gradient(180deg, var(--critical-bg) 0%, var(--surface) 58%); }
    .kpi-card.kpi-high     { border-top-color: var(--high);     background: linear-gradient(180deg, var(--high-bg) 0%, var(--surface) 58%); }
    .kpi-card.kpi-medium   { border-top-color: var(--medium);   background: linear-gradient(180deg, var(--medium-bg) 0%, var(--surface) 58%); }
    .kpi-card.kpi-low      { border-top-color: var(--low);      background: linear-gradient(180deg, var(--low-bg) 0%, var(--surface) 58%); }
    .kpi-card.kpi-info     { border-top-color: var(--info);     background: linear-gradient(180deg, var(--info-bg) 0%, var(--surface) 58%); }

    .kpi-card.kpi-critical .kpi-value { color: var(--critical); }
    .kpi-card.kpi-high .kpi-value { color: var(--high); }
    .kpi-card.kpi-medium .kpi-value { color: var(--medium); }
    .kpi-card.kpi-low .kpi-value { color: var(--low); }
    .kpi-card.kpi-info .kpi-value { color: var(--info); }

    .kpi-sub {
      font-size: 11.5px;
      color: var(--text-subtle);
      margin-top: 4px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Analytics Row */
    .analytics-grid {
      display: grid;
      grid-template-columns: minmax(300px, 1fr) minmax(320px, 1.3fr);
      gap: 16px;
      margin-bottom: 24px;
    }

    @media (max-width: 820px) {
      .analytics-grid {
        grid-template-columns: 1fr;
      }
    }

    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px 20px;
      box-shadow: var(--shadow);
    }

    .panel-title {
      margin: 0 0 12px;
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
    }

    .section-heading {
      margin: 28px 0 12px;
      font-size: 19px;
      font-weight: 800;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .section-count {
      font-size: 12px;
      font-weight: 700;
      background: var(--surface-alt);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 2px 9px;
      border-radius: 999px;
    }

    /* Tables */
    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    th, td {
      text-align: left;
      padding: 9px 10px;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
    }

    th {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-subtle);
      background: var(--surface-alt);
      font-weight: 700;
    }

    tr:last-child td {
      border-bottom: none;
    }

    /* Pills & Badges */
    .pill {
      display: inline-flex;
      align-items: center;
      padding: 2px 9px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border: 1px solid transparent;
      white-space: nowrap;
    }

    .pill-sev-critical { color: var(--critical); background: var(--critical-bg); border-color: var(--critical-border); }
    .pill-sev-high { color: var(--high); background: var(--high-bg); border-color: var(--high-border); }
    .pill-sev-medium { color: var(--medium); background: var(--medium-bg); border-color: var(--medium-border); }
    .pill-sev-low { color: var(--low); background: var(--low-bg); border-color: var(--low-border); }
    .pill-sev-info { color: var(--info); background: var(--info-bg); border-color: var(--info-border); }

    .pill-neutral { color: var(--text-muted); background: var(--surface-alt); border-color: var(--border-strong); text-transform: none; font-weight: 600; }
    .pill-triage-open { color: #b91c1c; background: #fef2f2; border-color: #fecaca; }
    .pill-triage-fixed { color: #15803d; background: #f0fdf4; border-color: #bbf7d0; }
    .pill-triage-false_positive { color: #475569; background: #f1f5f9; border-color: #cbd5e1; }
    .pill-triage-accepted { color: #92400e; background: #fffbeb; border-color: #fde68a; }
    .pill-preferred { color: #0f766e; background: #f0fdfa; border-color: #99f6e4; text-transform: none; }

    .method-badge {
      display: inline-block;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 11px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 5px;
      background: #e2e8f0;
      color: #0f172a;
    }

    .method-GET { background: #dbeafe; color: #1d4ed8; }
    .method-POST { background: #dcfce7; color: #15803d; }
    .method-PUT { background: #fef3c7; color: #b45309; }
    .method-DELETE { background: #fee2e2; color: #b91c1c; }

    /* Finding Cards */
    .finding-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-left: 5px solid var(--info);
      border-radius: var(--radius);
      padding: 18px 20px;
      margin-bottom: 16px;
      box-shadow: var(--shadow);
    }

    .finding-card.sev-critical { border-left-color: var(--critical); }
    .finding-card.sev-high { border-left-color: var(--high); }
    .finding-card.sev-medium { border-left-color: var(--medium); }
    .finding-card.sev-low { border-left-color: var(--low); }
    .finding-card.sev-info { border-left-color: var(--info); }

    .finding-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 10px;
    }

    .finding-title {
      margin: 0;
      font-size: 16px;
      font-weight: 800;
      color: var(--text);
    }

    .finding-index {
      color: var(--text-subtle);
      font-weight: 700;
      margin-right: 6px;
    }

    .pill-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 6px;
    }

    .endpoint-banner {
      background: #0f172a;
      color: #f8fafc;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 13px;
      font-weight: 600;
      padding: 9px 14px;
      border-radius: 7px;
      margin: 10px 0 12px;
      word-break: break-all;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 8px;
      align-items: center;
    }

    .endpoint-full-url {
      font-size: 11px;
      font-weight: 400;
      color: #94a3b8;
    }

    .finding-block {
      margin: 12px 0;
    }

    .block-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-subtle);
      font-weight: 700;
      margin-bottom: 5px;
    }

    /* Root Cause & Recommended Fix Insight Grid */
    .insight-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin: 14px 0;
    }

    @media (max-width: 780px) {
      .insight-grid {
        grid-template-columns: 1fr;
      }
    }

    .insight-card {
      border-radius: 9px;
      padding: 14px 16px;
      border: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .insight-card.insight-cause {
      background: #f8fafc;
      border-color: #cbd5e1;
      border-top: 3px solid #334155;
    }

    .insight-card.insight-fix {
      background: #f0fdf4;
      border-color: #bbf7d0;
      border-top: 3px solid #16a34a;
    }

    .insight-heading {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 11.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .insight-cause .insight-heading {
      color: #334155;
    }

    .insight-fix .insight-heading {
      color: #15803d;
    }

    .insight-text {
      margin: 0;
      font-size: 13.5px;
      line-height: 1.58;
      color: var(--text);
    }

    .insight-fix .insight-text {
      color: #14532d;
    }

    .code-locator-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px 14px;
      margin-bottom: 10px;
      padding: 9px 13px;
      border-radius: 8px;
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
      font-size: 12px;
      color: #334155;
    }

    .code-locator-main {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .code-locator-tag {
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #0f766e;
      background: #ccfbf1;
      border: 1px solid #99f6e4;
      padding: 2px 7px;
      border-radius: 5px;
    }

    .code-locator-note {
      font-size: 11px;
      color: #64748b;
    }

    .triage-note {
      margin: 10px 0;
      padding: 10px 14px;
      background: #fffbeb;
      border: 1px solid #fde68a;
      border-left: 3px solid #d97706;
      border-radius: 7px;
      color: #78350f;
      font-size: 13px;
    }

    /* Collapsible Details */
    details {
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #f8fafc;
      margin-top: 10px;
    }

    summary {
      cursor: pointer;
      padding: 9px 12px;
      font-weight: 700;
      font-size: 13px;
      color: var(--text);
      user-select: none;
    }

    details[open] summary {
      border-bottom: 1px solid var(--border);
    }

    .details-body {
      padding: 12px;
      background: var(--surface);
      border-radius: 0 0 8px 8px;
    }

    .evidence-table {
      width: 100%;
      border-collapse: collapse;
    }

    .evidence-table th {
      width: 190px;
      background: var(--surface-alt);
      text-transform: none;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 12px;
      color: var(--text);
    }

    .evidence-table td {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 12px;
      word-break: break-all;
      white-space: pre-wrap;
    }

    /* Before / After Code Diff Blocks — VS Code Dark+ Aesthetic */
    .snippet-section {
      margin-top: 14px;
    }

    .snippet-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 8px;
      flex-wrap: wrap;
    }

    .diff-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    @media (max-width: 820px) {
      .diff-grid {
        grid-template-columns: 1fr;
      }
    }

    .code-pane {
      border: 1px solid #303033;
      border-radius: 9px;
      overflow: hidden;
      background: #1e1e1e;
      box-shadow: 0 4px 14px rgba(15, 23, 42, 0.14);
      display: flex;
      flex-direction: column;
    }

    .code-pane.before {
      border-top: 2px solid #f14c4c;
    }

    .code-pane.after {
      border-top: 2px solid #2ea043;
    }

    .code-pane-bar {
      background: #252526;
      border-bottom: 1px solid #2d2d2d;
      padding: 0 12px 0 0;
      min-height: 36px;
      display: flex;
      justify-content: space-between;
      align-items: stretch;
      gap: 8px;
      user-select: none;
    }

    .vscode-tab {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 0 14px;
      background: #1e1e1e;
      border-right: 1px solid #2d2d2d;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 12px;
      color: #e5e7eb;
    }

    .vscode-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .code-pane.before .vscode-dot {
      background: #f14c4c;
      box-shadow: 0 0 6px rgba(241, 76, 76, 0.6);
    }

    .code-pane.after .vscode-dot {
      background: #3fb950;
      box-shadow: 0 0 6px rgba(63, 185, 80, 0.6);
    }

    .vscode-tab-meta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .vscode-diff-badge {
      font-size: 10.5px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 4px;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    .code-pane.before .vscode-diff-badge {
      background: rgba(241, 76, 76, 0.16);
      color: #fca5a5;
      border: 1px solid rgba(241, 76, 76, 0.35);
    }

    .code-pane.after .vscode-diff-badge {
      background: rgba(46, 160, 67, 0.18);
      color: #86efac;
      border: 1px solid rgba(63, 185, 80, 0.35);
    }

    .vscode-lang-pill {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 10.5px;
      font-weight: 600;
      text-transform: uppercase;
      color: #9ca3af;
      letter-spacing: 0.04em;
    }

    .vscode-editor {
      overflow-x: auto;
      background: #1e1e1e;
      padding: 10px 0;
      font-family: "JetBrains Mono", "Cascadia Code", "Fira Code", Consolas, ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12.5px;
      line-height: 1.62;
      color: #d4d4d4;
      scrollbar-width: thin;
      scrollbar-color: #424242 #1e1e1e;
    }

    .vscode-editor::-webkit-scrollbar {
      height: 8px;
      width: 8px;
    }

    .vscode-editor::-webkit-scrollbar-track {
      background: #1e1e1e;
    }

    .vscode-editor::-webkit-scrollbar-thumb {
      background: #424242;
      border-radius: 4px;
    }

    .vscode-editor::-webkit-scrollbar-thumb:hover {
      background: #555555;
    }

    .vscode-lines {
      display: table;
      width: 100%;
      border-collapse: collapse;
    }

    .vscode-line {
      display: table-row;
    }

    .vscode-line:hover {
      background: rgba(255, 255, 255, 0.04);
    }

    .vscode-line.diff-del {
      background: rgba(241, 76, 76, 0.14);
    }

    .vscode-line.diff-add {
      background: rgba(46, 160, 67, 0.16);
    }

    .vscode-ln {
      display: table-cell;
      width: 40px;
      min-width: 40px;
      padding: 0 10px 0 8px;
      text-align: right;
      color: #6e7681;
      user-select: none;
      -webkit-user-select: none;
      border-right: 1px solid #2b2b2b;
      vertical-align: top;
    }

    .vscode-marker {
      display: table-cell;
      width: 20px;
      min-width: 20px;
      text-align: center;
      font-weight: 700;
      user-select: none;
      -webkit-user-select: none;
      vertical-align: top;
      color: #6e7681;
    }

    .vscode-line.diff-del .vscode-marker {
      color: #f87171;
    }

    .vscode-line.diff-add .vscode-marker {
      color: #4ade80;
    }

    .code-pane.before .vscode-line.diff-del .vscode-ln {
      box-shadow: inset 3px 0 0 #f14c4c;
      color: #fca5a5;
    }

    .code-pane.after .vscode-line.diff-add .vscode-ln {
      box-shadow: inset 3px 0 0 #3fb950;
      color: #86efac;
    }

    .vscode-code {
      display: table-cell;
      padding: 0 16px 0 6px;
      white-space: pre;
      tab-size: 2;
    }

    /* Authentic VS Code Dark+ Syntax Tokens */
    .tok-plain { color: #d4d4d4; }
    .tok-comment { color: #6a9955; font-style: italic; }
    .tok-kw { color: #569cd6; }
    .tok-ctrl { color: #c586c0; }
    .tok-str { color: #ce9178; }
    .tok-fn { color: #dcdcaa; }
    .tok-dec { color: #dcdcaa; }
    .tok-num { color: #b5cea8; }
    .tok-tag { color: #569cd6; }
    .tok-attr { color: #9cdcfe; }

    pre {
      margin: 0;
      padding: 12px;
      overflow-x: auto;
      background: #1e1e1e;
      color: #d4d4d4;
      font-family: "JetBrains Mono", "Cascadia Code", Consolas, ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px;
      line-height: 1.55;
    }

    code {
      font-family: "JetBrains Mono", "Cascadia Code", Consolas, ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    .ref-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
      gap: 10px;
      margin-top: 8px;
    }

    .ref-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 14px;
      border-radius: 9px;
      border: 1px solid var(--border);
      background: #f8fafc;
      color: var(--text);
      text-decoration: none;
      transition: border-color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
    }

    .ref-card:hover {
      border-color: #0d9488;
      background: #f0fdfa;
      box-shadow: 0 2px 8px rgba(13, 148, 136, 0.12);
    }

    .ref-card-body {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .ref-card-title {
      font-size: 13px;
      font-weight: 700;
      color: #0f172a;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .ref-card-meta {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      color: #64748b;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    .ref-card-badge {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 1px 6px;
      border-radius: 4px;
      background: #e2e8f0;
      color: #334155;
    }

    .ref-card-arrow {
      flex-shrink: 0;
      font-size: 14px;
      font-weight: 700;
      color: #0d9488;
    }

    .param-chip {
      display: inline-block;
      background: var(--surface-alt);
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 1px 6px;
      margin: 1px 4px 1px 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 11px;
    }

    .empty-state {
      background: var(--clean-bg);
      border: 1px solid var(--clean-border);
      color: #166534;
      border-radius: var(--radius);
      padding: 20px;
      text-align: center;
      font-weight: 600;
    }

    .error-banner {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #991b1b;
      border-radius: var(--radius);
      padding: 14px 18px;
      margin-bottom: 20px;
    }

    .report-footer {
      margin-top: 32px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
      color: var(--text-subtle);
      font-size: 12px;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
    }

    @media print {
      body {
        background: #ffffff;
        padding: 0;
        font-size: 12px;
      }

      .report-banner {
        background: #0f172a !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        box-shadow: none;
      }

      .panel, .kpi-card, .finding-card {
        box-shadow: none;
        break-inside: avoid;
        page-break-inside: avoid;
      }

      .diff-grid {
        grid-template-columns: 1fr;
      }

      pre {
        white-space: pre-wrap;
        word-break: break-word;
      }

      a[href]::after {
        content: "";
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Report Header Banner -->
    <header class="report-banner">
      <div class="banner-main">
        <div class="banner-eyebrow">OWASP-Lite · Security Report</div>
        <h1 class="banner-title">{{ project.name }}</h1>
        <div class="meta-grid">
          <div class="meta-item"><strong>Profile:</strong> {{ scan.profile }}</div>
          <div class="meta-item"><strong>Target Stack:</strong> {{ project.target_stack_label }} ({{ project.target_stack }})</div>
          <div class="meta-item"><strong>Status:</strong> {{ scan.status }}</div>
          <div class="meta-item"><strong>Scan ID:</strong> {{ scan.id }}</div>
          <div class="meta-item"><strong>Generated:</strong> {{ generated_at_display }}</div>
        </div>
      </div>
      <div class="risk-badge risk-{{ scan.risk_slug }}">
        <div class="risk-score-label">Risk Score</div>
        <div class="risk-score-value">{{ scan.risk_score }}<span>/100</span></div>
        <div class="risk-score-level">{{ scan.risk_label }}</div>
      </div>
    </header>

    {% if scan.errors %}
    <section class="error-banner" aria-label="Scan Warnings">
      <strong>Scan Warnings / Errors ({{ scan.errors | length }}):</strong>
      <ul style="margin: 6px 0 0; padding-left: 18px;">
        {% for err in scan.errors %}
        <li>{{ err }}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <!-- Summary KPI Strip -->
    <section class="kpi-section" aria-label="Summary Metrics">
      <div class="kpi-row-overview">
        <div class="kpi-card">
          <div class="kpi-label">Total Findings</div>
          <div class="kpi-value">{{ summary.total_findings }}</div>
          <div class="kpi-sub">{{ summary.active_findings }} active{% if summary.false_positives %} · {{ summary.false_positives }} FP{% endif %}</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Endpoints</div>
          <div class="kpi-value">{{ summary.endpoints_discovered }}</div>
          <div class="kpi-sub">Discovered attack surface</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Pages Crawled</div>
          <div class="kpi-value">{{ scan.pages_crawled }}</div>
          <div class="kpi-sub">In-scope HTML &amp; routes</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Requests Sent</div>
          <div class="kpi-value">{{ scan.requests_sent }}</div>
          <div class="kpi-sub">Rate-limited HTTP probes</div>
        </div>
      </div>

      <div class="kpi-row-severity">
        <div class="kpi-card kpi-sev kpi-critical">
          <div class="kpi-label">Critical</div>
          <div class="kpi-value">{{ summary.severity_counts.critical }}</div>
        </div>
        <div class="kpi-card kpi-sev kpi-high">
          <div class="kpi-label">High</div>
          <div class="kpi-value">{{ summary.severity_counts.high }}</div>
        </div>
        <div class="kpi-card kpi-sev kpi-medium">
          <div class="kpi-label">Medium</div>
          <div class="kpi-value">{{ summary.severity_counts.medium }}</div>
        </div>
        <div class="kpi-card kpi-sev kpi-low">
          <div class="kpi-label">Low</div>
          <div class="kpi-value">{{ summary.severity_counts.low }}</div>
        </div>
        <div class="kpi-card kpi-sev kpi-info">
          <div class="kpi-label">Info</div>
          <div class="kpi-value">{{ summary.severity_counts.info }}</div>
        </div>
      </div>
    </section>

    <!-- Inline SVG Severity Chart + OWASP Top 10 Breakdown -->
    <section class="analytics-grid" aria-label="Vulnerability Distribution">
      <div class="panel">
        <h2 class="panel-title">Active Findings by Severity</h2>
        <svg viewBox="0 0 420 180" width="100%" height="180" role="img" aria-label="Severity distribution bar chart">
          {% for row in svg_chart_rows %}
          <text x="4" y="{{ row.label_y }}" font-size="12" font-weight="600" fill="#334155">{{ row.label }}</text>
          <rect x="96" y="{{ row.y }}" width="270" height="20" rx="5" fill="#f1f5f9"></rect>
          {% if row.bar_width > 0 %}
          <rect x="96" y="{{ row.y }}" width="{{ row.bar_width }}" height="20" rx="5" fill="{{ row.color }}"></rect>
          {% endif %}
          <text x="{{ row.count_x }}" y="{{ row.label_y }}" font-size="12" font-weight="700" fill="#0f172a">{{ row.count }}</text>
          {% endfor %}
        </svg>
      </div>

      <div class="panel">
        <h2 class="panel-title">OWASP Top 10 (2021) Breakdown</h2>
        {% if summary.owasp_breakdown %}
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>OWASP Category</th>
                <th>Active</th>
                <th>Total</th>
                <th>Highest Severity</th>
              </tr>
            </thead>
            <tbody>
              {% for row in summary.owasp_breakdown %}
              <tr>
                <td>{{ row.category }}</td>
                <td><strong>{{ row.active }}</strong></td>
                <td>{{ row.total }}</td>
                <td><span class="pill pill-sev-{{ row.highest_severity }}">{{ row.highest_severity }}</span></td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% else %}
        <p style="color: var(--text-subtle); margin: 0;">No OWASP categories triggered during this scan.</p>
        {% endif %}
      </div>
    </section>

    <!-- Detailed Findings Section -->
    <h2 class="section-heading">
      Detailed Security Findings
      <span class="section-count">{{ findings | length }}</span>
    </h2>

    {% if findings %}
      {% for f in findings %}
      <article class="finding-card sev-{{ f.severity }}" id="finding-{{ f.index }}">
        <div class="finding-header">
          <div>
            <h3 class="finding-title">
              <span class="finding-index">#{{ f.index }}</span>{{ f.title }}
            </h3>
            <div class="pill-row">
              <span class="pill pill-sev-{{ f.severity }}">{{ f.severity }}</span>
              <span class="pill pill-neutral">Confidence: {{ f.confidence }}</span>
              <span class="pill pill-triage-{{ f.triage_status }}">Triage: {{ f.triage_status | replace('_', ' ') }}</span>
              <span class="pill pill-neutral">{{ f.owasp_category }}</span>
              <span class="pill pill-neutral">{{ f.cwe_id }}</span>
              <span class="pill pill-neutral">Check: {{ f.check_id }}</span>
            </div>
          </div>
        </div>

        <!-- Exact Endpoint Banner -->
        <div class="endpoint-banner">
          <span>{{ f.endpoint_banner }}</span>
        </div>

        <!-- Plain-Language Root Cause & Recommended Action -->
        <div class="insight-grid">
          <div class="insight-card insight-cause">
            <div class="insight-heading">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span>Why This Matters &amp; Root Cause</span>
            </div>
            <p class="insight-text">{{ f.explanation }}</p>
          </div>
          {% if f.fix_summary %}
          <div class="insight-card insight-fix">
            <div class="insight-heading">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
              <span>Recommended Fix Strategy</span>
            </div>
            <p class="insight-text">{{ f.fix_summary }}</p>
          </div>
          {% endif %}
        </div>
        {% if f.triage_note %}
        <div class="triage-note"><strong>Triage Note:</strong> {{ f.triage_note }}</div>
        {% endif %}

        <!-- Collapsible Proof-of-Detection Evidence (Strictly Autoescaped) -->
        {% if f.evidence_items %}
        <details>
          <summary>Proof-of-Detection Evidence ({{ f.evidence_items | length }} fields)</summary>
          <div class="details-body">
            <div class="table-wrap">
              <table class="evidence-table">
                <tbody>
                  {% for key, val in f.evidence_items %}
                  <tr>
                    <th>{{ key }}</th>
                    <td>{{ val }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </details>
        {% endif %}

        <!-- Copy-Ready Before vs. After Multi-Stack Code Fixes -->
        {% if f.primary_snippet %}
        <div class="snippet-section">
          <div class="snippet-header">
            <div class="block-label" style="margin-bottom: 0;">Copy-Ready Code Fix — {{ f.primary_snippet.label }}</div>
            {% if f.primary_snippet.is_preferred %}
            <span class="pill pill-preferred">Project Stack: {{ project.target_stack }}</span>
            {% endif %}
          </div>
          <div class="code-locator-bar">
            <div class="code-locator-main">
              <span class="code-locator-tag">Where to Patch</span>
              <span>{{ f.code_locator.search_hint }}</span>
            </div>
            <span class="code-locator-note">DAST pinpoints HTTP route &amp; parameter · red/green lines mark exact code diff</span>
          </div>
          <div class="diff-grid">
            <div class="code-pane before">
              <div class="code-pane-bar">
                <div class="vscode-tab">
                  <span class="vscode-dot"></span>
                  <span>{{ f.primary_snippet.filename }}</span>
                </div>
                <div class="vscode-tab-meta">
                  <span class="vscode-diff-badge">Before · Vulnerable</span>
                  <span class="vscode-lang-pill">{{ f.primary_snippet.language }}</span>
                </div>
              </div>
              <div class="vscode-editor"><div class="vscode-lines">{% for line in f.primary_snippet.before_lines %}<div class="vscode-line diff-{{ line.diff }}"><span class="vscode-ln">{{ line.num }}</span><span class="vscode-marker">{{ line.marker }}</span><span class="vscode-code">{% for tok in line.tokens %}<span class="{{ tok.cls }}">{{ tok.text }}</span>{% endfor %}</span></div>{% endfor %}</div></div>
            </div>
            <div class="code-pane after">
              <div class="code-pane-bar">
                <div class="vscode-tab">
                  <span class="vscode-dot"></span>
                  <span>{{ f.primary_snippet.filename }}</span>
                </div>
                <div class="vscode-tab-meta">
                  <span class="vscode-diff-badge">After · Secure Fix</span>
                  <span class="vscode-lang-pill">{{ f.primary_snippet.language }}</span>
                </div>
              </div>
              <div class="vscode-editor"><div class="vscode-lines">{% for line in f.primary_snippet.after_lines %}<div class="vscode-line diff-{{ line.diff }}"><span class="vscode-ln">{{ line.num }}</span><span class="vscode-marker">{{ line.marker }}</span><span class="vscode-code">{% for tok in line.tokens %}<span class="{{ tok.cls }}">{{ tok.text }}</span>{% endfor %}</span></div>{% endfor %}</div></div>
            </div>
          </div>

          {% if f.secondary_snippets %}
          <details>
            <summary>Other Stack Examples ({{ f.secondary_snippets | length }} additional stacks)</summary>
            <div class="details-body">
              {% for snip in f.secondary_snippets %}
              <div style="margin-bottom: 16px;">
                <div class="block-label">{{ snip.label }}</div>
                <div class="diff-grid">
                  <div class="code-pane before">
                    <div class="code-pane-bar">
                      <div class="vscode-tab">
                        <span class="vscode-dot"></span>
                        <span>{{ snip.filename }}</span>
                      </div>
                      <div class="vscode-tab-meta">
                        <span class="vscode-diff-badge">Before · Vulnerable</span>
                        <span class="vscode-lang-pill">{{ snip.language }}</span>
                      </div>
                    </div>
                    <div class="vscode-editor"><div class="vscode-lines">{% for line in snip.before_lines %}<div class="vscode-line diff-{{ line.diff }}"><span class="vscode-ln">{{ line.num }}</span><span class="vscode-marker">{{ line.marker }}</span><span class="vscode-code">{% for tok in line.tokens %}<span class="{{ tok.cls }}">{{ tok.text }}</span>{% endfor %}</span></div>{% endfor %}</div></div>
                  </div>
                  <div class="code-pane after">
                    <div class="code-pane-bar">
                      <div class="vscode-tab">
                        <span class="vscode-dot"></span>
                        <span>{{ snip.filename }}</span>
                      </div>
                      <div class="vscode-tab-meta">
                        <span class="vscode-diff-badge">After · Secure Fix</span>
                        <span class="vscode-lang-pill">{{ snip.language }}</span>
                      </div>
                    </div>
                    <div class="vscode-editor"><div class="vscode-lines">{% for line in snip.after_lines %}<div class="vscode-line diff-{{ line.diff }}"><span class="vscode-ln">{{ line.num }}</span><span class="vscode-marker">{{ line.marker }}</span><span class="vscode-code">{% for tok in line.tokens %}<span class="{{ tok.cls }}">{{ tok.text }}</span>{% endfor %}</span></div>{% endfor %}</div></div>
                  </div>
                </div>
              </div>
              {% endfor %}
            </div>
          </details>
          {% endif %}
        </div>
        {% endif %}

        <!-- OWASP Reference Cards -->
        {% if f.reference_cards %}
        <div class="finding-block">
          <div class="block-label">OWASP &amp; Remediation References</div>
          <div class="ref-grid">
            {% for ref in f.reference_cards %}
            <a class="ref-card" href="{{ ref.url }}" target="_blank" rel="noopener noreferrer">
              <div class="ref-card-body">
                <span class="ref-card-title">{{ ref.title }}</span>
                <span class="ref-card-meta">
                  <span class="ref-card-badge">{{ ref.category }}</span>
                  <span>{{ ref.domain }}</span>
                </span>
              </div>
              <span class="ref-card-arrow" aria-hidden="true">&#8599;</span>
            </a>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </article>
      {% endfor %}
    {% else %}
      <div class="empty-state">
        No security findings were detected during this scan.
      </div>
    {% endif %}

    <!-- Discovered Attack Surface (Endpoints Table) -->
    <h2 class="section-heading">
      Discovered Attack Surface
      <span class="section-count">{{ endpoints | length }} endpoints</span>
    </h2>

    <section class="panel" aria-label="Discovered Endpoints">
      {% if endpoints %}
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Method</th>
              <th>Endpoint URL</th>
              <th>Parameters</th>
              <th>Source</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {% for ep in endpoints %}
            <tr>
              <td><span class="method-badge method-{{ ep.method }}">{{ ep.method }}</span></td>
              <td style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; word-break: break-all;">{{ ep.url }}</td>
              <td>
                {% if ep.params %}
                  {% for param in ep.params %}
                  <span class="param-chip">{{ param }}</span>
                  {% endfor %}
                {% else %}
                  <span style="color: var(--text-subtle);">—</span>
                {% endif %}
              </td>
              <td>{{ ep.source }}</td>
              <td>{{ ep.status_code if ep.status_code else '—' }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <p style="color: var(--text-subtle); margin: 0;">No endpoints were recorded for this scan.</p>
      {% endif %}
    </section>

    <!-- Footer -->
    <footer class="report-footer">
      <div>{{ app_name }} v{{ app_version }} · Self-Contained Offline HTML5 Report</div>
      <div>Started: {{ started_at_display }} · Finished: {{ finished_at_display }}</div>
    </footer>
  </div>
</body>
</html>
