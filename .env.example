# Application environment
ENV=development
APP_PORT=8000

# Persistence (defaults to SQLite with WAL mode; swap for PostgreSQL when using --profile postgres)
DATABASE_URL=sqlite:///./data/scanner.db
# DATABASE_URL=postgresql+psycopg://scanner:scanner@postgres:5432/scanner

# Mandatory scope & safety guardrails (authorized local/testbench targets only)
SCAN_ALLOWLIST=localhost,127.0.0.1,host.docker.internal,dvwa,juice-shop,vulnbench
SCAN_RATE_LIMIT_RPS=10
SCAN_MAX_REQUESTS=2000
